{
  "manifest_version": 3,
  "name": "StreamKEK",
  "version": "1.4.2",
  "minimum_chrome_version": "145",
  "description": "Gives you more control over watching and chatting on Twitch, and brings YouTube and Kick live streams and their chat there too.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "contentSettings",
    "cookies",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.twitch.tv/*",
    "https://kick.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "StreamKEK",
    "default_popup": "src/settings-window/settings-window.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "src/settings.js",
        "src/features/streams/sites.js",
        "src/twitch/helpers.js",
        "src/twitch/page-sync.js",
        "src/twitch/gql.js",
        "src/twitch/settings-button.js",
        "src/features/streams/twitch/state.js",
        "src/features/streams/twitch/format.js",
        "src/features/streams/twitch/multi-layout.js",
        "src/features/streams/twitch/stream-tip.js",
        "src/features/streams/twitch/manager-frame.js",
        "src/features/streams/twitch/sidebar-drag.js",
        "src/features/streams/twitch/favorites.js",
        "src/features/streams/twitch/sidebar.js",
        "src/features/streams/twitch/view-frames.js",
        "src/features/streams/twitch/view-layouts.js",
        "src/features/streams/twitch/stream-view.js",
        "src/features/streams/twitch/multi-view.js",
        "src/features/streams/twitch/routes.js",
        "src/features/streams/twitch/following.js",
        "src/features/streams/twitch/main.js",
        "src/features/sidebar/preview.js",
        "src/features/sidebar/current-channel.js",
        "src/features/chat/claim-points.js",
        "src/features/chat/chat-words.js",
        "src/features/chat/emotes.js",
        "src/features/chat/emote-picker.js",
        "src/features/player/floating-window.js",
        "src/features/player/modes.js"
      ],
      "css": [
        "src/twitch/base.css",
        "src/twitch/settings-button.css",
        "src/features/sidebar/sections.css",
        "src/features/sidebar/preview.css",
        "src/features/sidebar/current-channel.css",
        "src/features/chat/font-size.css",
        "src/features/chat/timestamps.css",
        "src/features/chat/sections.css",
        "src/features/chat/chat-words.css",
        "src/features/chat/emotes.css",
        "src/features/chat/emote-picker.css",
        "src/features/player/extensions.css",
        "src/features/player/modes.css",
        "src/features/player/floating-window.css",
        "src/features/streams/twitch/sidebar.css",
        "src/features/streams/twitch/favorites.css",
        "src/features/streams/twitch/stream-tip.css",
        "src/features/streams/twitch/manager-frame.css",
        "src/features/streams/twitch/stream-view.css",
        "src/features/streams/twitch/multi-view.css",
        "src/features/streams/twitch/following.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "src/features/player/quality.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "src/features/chat/chat-box-emotes.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://player.twitch.tv/*"
      ],
      "js": [
        "src/settings.js",
        "src/features/streams/frames/layout-keys.js",
        "src/features/streams/frames/audio.js",
        "src/features/player/embed-quality.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://player.twitch.tv/*"
      ],
      "js": [
        "src/features/player/quality.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.twitch.tv/embed/*"
      ],
      "js": [
        "src/settings.js",
        "src/twitch/page-sync.js",
        "src/twitch/gql.js",
        "src/features/streams/frames/layout-keys.js",
        "src/features/chat/chat-words.js",
        "src/features/chat/emotes.js",
        "src/features/chat/emote-picker.js"
      ],
      "css": [
        "src/features/chat/font-size.css",
        "src/features/chat/timestamps.css",
        "src/features/chat/sections.css",
        "src/features/chat/chat-words.css",
        "src/features/chat/emotes.css",
        "src/features/chat/emote-picker.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "js": [
        "src/settings.js",
        "src/features/streams/frames/layout-keys.js",
        "src/features/streams/frames/chat-settings.js",
        "src/features/youtube/frames/chat.js",
        "src/features/chat/chat-words.js"
      ],
      "css": [
        "src/features/youtube/frames/chat.css",
        "src/features/chat/chat-words.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "js": [
        "src/settings.js",
        "src/features/streams/frames/layout-keys.js",
        "src/features/streams/frames/mouse-activity.js",
        "src/features/streams/frames/audio.js",
        "src/features/youtube/frames/watch.js"
      ],
      "css": [
        "src/features/youtube/frames/watch.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "js": [
        "src/features/youtube/frames/watch-start.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://kick.com/popout/*"
      ],
      "js": [
        "src/settings.js",
        "src/features/streams/frames/layout-keys.js",
        "src/features/streams/frames/chat-settings.js",
        "src/features/kick/frames/chat.js",
        "src/features/chat/chat-words.js"
      ],
      "css": [
        "src/features/kick/frames/chat.css",
        "src/features/chat/chat-words.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://kick.com/*"
      ],
      "exclude_matches": [
        "https://kick.com/popout/*"
      ],
      "js": [
        "src/settings.js",
        "src/features/streams/frames/layout-keys.js",
        "src/features/streams/frames/mouse-activity.js",
        "src/features/streams/frames/audio.js",
        "src/features/kick/frames/watch.js"
      ],
      "css": [
        "src/features/kick/frames/watch.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://kick.com/*"
      ],
      "exclude_matches": [
        "https://kick.com/popout/*"
      ],
      "js": [
        "src/features/kick/frames/watch-start.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/48.png",
        "src/settings-window/settings-window.html",
        "src/features/streams/manager/manager.html"
      ],
      "matches": [
        "https://www.twitch.tv/*"
      ]
    },
    {
      "resources": [
        "fonts/inter-latin.woff2"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_watch_frame",
        "enabled": true,
        "path": "rules/youtube-watch-frame.json"
      }
    ]
  }
}
