{
  "manifest_version": 3,
  "name": "StreamKEK",
  "version": "1.0.2",
  "minimum_chrome_version": "145",
  "description": "Gives you more control over watching and chatting on Twitch, and brings YouTube live streams and their chat there too.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "contentSettings",
    "cookies",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.twitch.tv/*",
    "https://kick.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "StreamKEK",
    "default_popup": "src/settings-window/settings-window.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "src/settings.js",
        "src/features/streams/sites.js",
        "src/twitch/helpers.js",
        "src/twitch/page-sync.js",
        "src/twitch/settings-button.js",
        "src/features/streams/twitch/state.js",
        "src/features/streams/twitch/format.js",
        "src/features/streams/twitch/stream-tip.js",
        "src/features/streams/twitch/manager-frame.js",
        "src/features/streams/twitch/sidebar.js",
        "src/features/streams/twitch/player-view.js",
        "src/features/streams/twitch/routes.js",
        "src/features/streams/twitch/following.js",
        "src/features/streams/twitch/main.js",
        "src/features/sidebar-preview/sidebar-preview.js",
        "src/features/claim-points/claim-points.js",
        "src/features/player-modes/floating-window.js",
        "src/features/player-modes/player-modes.js"
      ],
      "css": [
        "src/twitch/base.css",
        "src/twitch/settings-button.css",
        "src/features/sidebar-sections/sidebar-sections.css",
        "src/features/sidebar-preview/sidebar-preview.css",
        "src/features/chat-font-size/chat-font-size.css",
        "src/features/chat-timestamps/chat-timestamps.css",
        "src/features/chat-sections/chat-sections.css",
        "src/features/player-extensions/player-extensions.css",
        "src/features/player-modes/player-modes.css",
        "src/features/player-modes/floating-window.css",
        "src/features/streams/twitch/sidebar.css",
        "src/features/streams/twitch/stream-tip.css",
        "src/features/streams/twitch/manager-frame.css",
        "src/features/streams/twitch/player-view.css",
        "src/features/streams/twitch/following.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "src/features/stream-quality/stream-quality.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "js": [
        "src/settings.js",
        "src/features/streams/frames/layout-keys.js",
        "src/features/youtube/frames/chat.js"
      ],
      "css": [
        "src/features/youtube/frames/chat.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "js": [
        "src/settings.js",
        "src/features/streams/frames/layout-keys.js",
        "src/features/youtube/frames/watch.js"
      ],
      "css": [
        "src/features/youtube/frames/watch.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "js": [
        "src/features/youtube/frames/watch-start.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://kick.com/popout/*"
      ],
      "js": [
        "src/settings.js",
        "src/features/streams/frames/layout-keys.js",
        "src/features/kick/frames/chat.js"
      ],
      "css": [
        "src/features/kick/frames/chat.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://kick.com/*"
      ],
      "exclude_matches": [
        "https://kick.com/popout/*"
      ],
      "js": [
        "src/settings.js",
        "src/features/streams/frames/layout-keys.js",
        "src/features/kick/frames/watch.js"
      ],
      "css": [
        "src/features/kick/frames/watch.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://kick.com/*"
      ],
      "exclude_matches": [
        "https://kick.com/popout/*"
      ],
      "js": [
        "src/features/kick/frames/watch-start.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/48.png",
        "src/settings-window/settings-window.html",
        "src/features/streams/manager/manager.html"
      ],
      "matches": [
        "https://www.twitch.tv/*"
      ]
    },
    {
      "resources": [
        "fonts/inter-latin.woff2"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_watch_frame",
        "enabled": true,
        "path": "rules/youtube-watch-frame.json"
      },
      {
        "id": "youtube_guide_origin",
        "enabled": true,
        "path": "rules/youtube-guide-origin.json"
      },
      {
        "id": "kick_api_origin",
        "enabled": true,
        "path": "rules/kick-api-origin.json"
      }
    ]
  }
}
